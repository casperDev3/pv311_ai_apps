# Конфігурація ресурсів системи
class ResourceConfig:
    def __init__(self,
                 max_cpu_usage=80,  # Максимальне використання CPU (%)
                 max_memory_usage=85,  # Максимальне використання RAM (%)
                 batch_size=32,  # Розмір батчу
                 num_workers=2,  # Кількість потоків для завантаження даних
                 pin_memory=True,  # Прискорення передачі на GPU
                 mixed_precision=True,  # Змішана точність для економії пам'яті
                 gradient_accumulation=1,  # Акумуляція градієнтів
                 checkpoint_freq=5):  # Частота збереження чекпоінтів

        self.max_cpu_usage = max_cpu_usage
        self.max_memory_usage = max_memory_usage
        self.batch_size = batch_size
        self.num_workers = num_workers
        self.pin_memory = pin_memory
        self.mixed_precision = mixed_precision
        self.gradient_accumulation = gradient_accumulation
        self.checkpoint_freq = checkpoint_freq

        # Автоматичне налаштування параметрів
        self._auto_adjust_parameters()

    def _auto_adjust_parameters(self):
        """Автоматичне налаштування параметрів базуючись на доступних ресурсах"""
        # Отримання інформації про систему
        cpu_count = psutil.cpu_count(logical=False)
        memory_gb = psutil.virtual_memory().total / (1024 ** 3)

        # Налаштування кількості воркерів
        if self.num_workers == -1:
            self.num_workers = min(cpu_count, 8)

        # Налаштування розміру батчу базуючись на доступній пам'яті
        if torch.cuda.is_available():
            gpu_memory_gb = torch.cuda.get_device_properties(0).total_memory / (1024 ** 3)
            if gpu_memory_gb < 4:
                self.batch_size = min(self.batch_size, 16)
            elif gpu_memory_gb < 8:
                self.batch_size = min(self.batch_size, 32)
        else:
            if memory_gb < 8:
                self.batch_size = min(self.batch_size, 16)

        print(f"Автоматичні налаштування:")
        print(f"  Розмір батчу: {self.batch_size}")
        print(f"  Кількість воркерів: {self.num_workers}")
        print(f"  Змішана точність: {self.mixed_precision}")


# Клас для моніторингу ресурсів
class ResourceMonitor:
    def __init__(self, config):
        self.config = config
        self.monitoring = False
        self.monitor_thread = None

    def start_monitoring(self):
        """Запуск моніторингу ресурсів"""
        self.monitoring = True
        self.monitor_thread = threading.Thread(target=self._monitor_loop)
        self.monitor_thread.daemon = True
        self.monitor_thread.start()

    def stop_monitoring(self):
        """Зупинка моніторингу"""
        self.monitoring = False
        if self.monitor_thread:
            self.monitor_thread.join()

    def _monitor_loop(self):
        """Основний цикл моніторингу"""
        while self.monitoring:
            cpu_percent = psutil.cpu_percent()
            memory_percent = psutil.virtual_memory().percent

            # Якщо використання ресурсів перевищує ліміти, додаємо затримку
            if cpu_percent > self.config.max_cpu_usage or memory_percent > self.config.max_memory_usage:
                print(f"Високе використання ресурсів: CPU {cpu_percent:.1f}%, RAM {memory_percent:.1f}%")
                time.sleep(1)  # Затримка для зменшення навантаження

            time.sleep(0.5)

    def get_resource_usage(self):
        """Отримання поточного використання ресурсів"""
        return {
            'cpu': psutil.cpu_percent(),
            'memory': psutil.virtual_memory().percent,
            'gpu_memory': torch.cuda.memory_allocated() / torch.cuda.max_memory_allocated() * 100 if torch.cuda.is_available() else 0
        }


# Клас для створення датасету котиків з CIFAR-10
class CatDataset(Dataset):
    def __init__(self, cifar_dataset, max_samples=None):
        self.data = []
        self.labels = []
        sample_count = 0

        for i, (img, label) in enumerate(cifar_dataset):
            if max_samples and sample_count >= max_samples:
                break

            # Створюємо бінарну класифікацію: 1 - котик, 0 - не котик
            if label == 3:  # Котик
                self.data.append(img)
                self.labels.append(1)
                sample_count += 1
            elif i % 10 == 0:  # Беремо кожне 10-те не-котикове зображення для балансу
                self.data.append(img)
                self.labels.append(0)
                sample_count += 1

    def __len__(self):
        return len(self.data)

    def __getitem__(self, idx):
        return self.data[idx], self.labels[idx]


# Оптимізована архітектура нейронної мережі
class OptimizedCatDetectionCNN(nn.Module):
    def __init__(self, dropout_rate=0.3):
        super(OptimizedCatDetectionCNN, self).__init__()

        # Використання сучасних технік оптимізації
        self.conv_layers = nn.Sequential(
            # Перший блок - менше каналів для швидкості
            nn.Conv2d(3, 16, kernel_size=3, padding=1),
            nn.BatchNorm2d(16),
            nn.ReLU(inplace=True),
            nn.Conv2d(16, 32, kernel_size=3, padding=1),
            nn.BatchNorm2d(32),
            nn.ReLU(inplace=True),
            nn.MaxPool2d(2, 2),
            nn.Dropout2d(dropout_rate / 2),

            # Другий блок
            nn.Conv2d(32, 64, kernel_size=3, padding=1),
            nn.BatchNorm2d(64),
            nn.ReLU(inplace=True),
            nn.Conv2d(64, 64, kernel_size=3, padding=1),
            nn.BatchNorm2d(64),
            nn.ReLU(inplace=True),
            nn.MaxPool2d(2, 2),
            nn.Dropout2d(dropout_rate / 2),

            # Третій блок - зменшений для економії пам'яті
            nn.Conv2d(64, 128, kernel_size=3, padding=1),
            nn.BatchNorm2d(128),
            nn.ReLU(inplace=True),
            nn.MaxPool2d(2, 2),
            nn.Dropout2d(dropout_rate / 2),

            # Глобальний average pooling замість flatten
            nn.AdaptiveAvgPool2d((4, 4))
        )

        # Компактний класифікатор
        self.classifier = nn.Sequential(
            nn.Flatten(),
            nn.Linear(128 * 4 * 4, 256),
            nn.ReLU(inplace=True),
            nn.Dropout(dropout_rate),
            nn.Linear(256, 64),
            nn.ReLU(inplace=True),
            nn.Dropout(dropout_rate),
            nn.Linear(64, 2)  # 2 класи: котик/не котик
        )

    def forward(self, x):
        x = self.conv_layers(x)
        x = self.classifier(x)
        return x


def cleanup_memory():
    """Очищення пам'яті"""
    gc.collect()
    if torch.cuda.is_available():
        torch.cuda.empty_cache()


# Оптимізована функція тренування з контролем ресурсів
def train_model_optimized(model, train_loader, test_loader, resource_monitor, scaler, scheduler, criterion, optimizer,
                          num_epochs=15):
    train_losses = []
    train_accuracies = []
    test_accuracies = []

    # Запуск моніторингу ресурсів
    resource_monitor.start_monitoring()

    best_test_acc = 0.0
    patience = 5
    patience_counter = 0

    try:
        for epoch in range(num_epochs):
            print(f"\nЕпоха [{epoch + 1}/{num_epochs}]")

            # Моніторинг ресурсів
            resources = resource_monitor.get_resource_usage()
            print(f"Використання ресурсів - CPU: {resources['cpu']:.1f}%, RAM: {resources['memory']:.1f}%")

            # Тренування
            model.train()
            running_loss = 0.0
            correct_train = 0
            total_train = 0

            optimizer.zero_grad()

            for batch_idx, (data, target) in enumerate(train_loader):
                data, target = data.to(device, non_blocking=True), target.to(device, non_blocking=True)

                # Використання змішаної точності якщо доступна
                if scaler and resource_config.mixed_precision:
                    with torch.cuda.amp.autocast():
                        output = model(data)
                        loss = criterion(output, target) / resource_config.gradient_accumulation

                    scaler.scale(loss).backward()

                    if (batch_idx + 1) % resource_config.gradient_accumulation == 0:
                        scaler.step(optimizer)
                        scaler.update()
                        optimizer.zero_grad()
                else:
                    output = model(data)
                    loss = criterion(output, target) / resource_config.gradient_accumulation
                    loss.backward()

                    if (batch_idx + 1) % resource_config.gradient_accumulation == 0:
                        optimizer.step()
                        optimizer.zero_grad()

                running_loss += loss.item() * resource_config.gradient_accumulation
                _, predicted = torch.max(output.data, 1)
                total_train += target.size(0)
                correct_train += (predicted == target).sum().item()

                if batch_idx % 50 == 0:
                    current_loss = loss.item() * resource_config.gradient_accumulation
                    print(f'  Батч [{batch_idx}/{len(train_loader)}], Loss: {current_loss:.4f}')

            # Обчислення точності на тренувальних даних
            train_accuracy = 100 * correct_train / total_train
            avg_loss = running_loss / len(train_loader)

            # Тестування
            model.eval()
            correct_test = 0
            total_test = 0

            with torch.no_grad():
                for data, target in test_loader:
                    data, target = data.to(device, non_blocking=True), target.to(device, non_blocking=True)

                    if scaler and resource_config.mixed_precision:
                        with torch.cuda.amp.autocast():
                            output = model(data)
                    else:
                        output = model(data)

                    _, predicted = torch.max(output.data, 1)
                    total_test += target.size(0)
                    correct_test += (predicted == target).sum().item()

            test_accuracy = 100 * correct_test / total_test

            # Збереження результатів
            train_losses.append(avg_loss)
            train_accuracies.append(train_accuracy)
            test_accuracies.append(test_accuracy)

            print(f'  Тренувальна точність: {train_accuracy:.2f}%')
            print(f'  Тестова точність: {test_accuracy:.2f}%')
            print(f'  Середня втрата: {avg_loss:.4f}')
            print(f'  Learning rate: {optimizer.param_groups[0]["lr"]:.6f}')

            # Early stopping
            if test_accuracy > best_test_acc:
                best_test_acc = test_accuracy
                patience_counter = 0
                # Збереження найкращої моделі
                torch.save({
                    'epoch': epoch,
                    'model_state_dict': model.state_dict(),
                    'optimizer_state_dict': optimizer.state_dict(),
                    'best_acc': best_test_acc,
                    'model_class': OptimizedCatDetectionCNN,
                }, 'best_cat_detection_model.pth')
            else:
                patience_counter += 1

            if patience_counter >= patience:
                print(f"Early stopping на епосі {epoch + 1}")
                break

            # Збереження чекпоінту
            if (epoch + 1) % resource_config.checkpoint_freq == 0:
                torch.save({
                    'epoch': epoch,
                    'model_state_dict': model.state_dict(),
                    'optimizer_state_dict': optimizer.state_dict(),
                    'scheduler_state_dict': scheduler.state_dict(),
                    'loss': avg_loss,
                    'model_class': OptimizedCatDetectionCNN,
                }, f'checkpoint_epoch_{epoch + 1}.pth')

            scheduler.step()
            cleanup_memory()  # Очищення пам'яті після кожної епохи

            print('-' * 50)

    finally:
        # Зупинка моніторингу
        resource_monitor.stop_monitoring()
        cleanup_memory()

    return train_losses, train_accuracies, test_accuracies, best_test_acc


# Функція для завантаження зображення з URL (оптимізована)
def load_image_from_url(url, timeout=10):
    try:
        response = requests.get(url, timeout=timeout)
        response.raise_for_status()
        img = Image.open(BytesIO(response.content)).convert('RGB')
        return img
    except Exception as e:
        print(f"Помилка завантаження зображення: {e}")
        return None


# Оптимізована функція для передбачення
def predict_cat_optimized(model, image_path_or_url, transform, scaler=None, device=None):
    model.eval()

    # Завантаження зображення
    if image_path_or_url.startswith('http'):
        image = load_image_from_url(image_path_or_url)
    else:
        image = Image.open(image_path_or_url).convert('RGB')

    if image is None:
        return None, None, None

    # Попередня обробка
    input_tensor = transform(image).unsqueeze(0).to(device, non_blocking=True)

    with torch.no_grad():
        if scaler and resource_config.mixed_precision:
            with torch.cuda.amp.autocast():
                output = model(input_tensor)
        else:
            output = model(input_tensor)

        probabilities = torch.softmax(output, dim=1)
        confidence_scores = probabilities.cpu().numpy()[0]
        predicted = torch.argmax(probabilities, dim=1).item()

    is_cat = predicted == 1
    confidence = confidence_scores[predicted] * 100

    # Додаткові метрики
    cat_confidence = confidence_scores[1] * 100
    not_cat_confidence = confidence_scores[0] * 100

    return is_cat, confidence, image, {
        'cat_probability': cat_confidence,
        'not_cat_probability': not_cat_confidence
    }


# Функція для збереження моделі з метаданими
def save_model_with_metadata(model, path, metadata=None, resource_config=None):
    save_dict = {
        'model_state_dict': model.state_dict(),
        'model_class': OptimizedCatDetectionCNN,
        'resource_config': resource_config.__dict__ if resource_config else {},
        'total_parameters': sum(p.numel() for p in model.parameters()),
        'model_size_mb': sum(p.numel() * p.element_size() for p in model.parameters()) / (1024 * 1024)
    }

    if metadata:
        save_dict.update(metadata)

    torch.save(save_dict, path)
    print(f"Модель збережена як {path}")
    print(f"Розмір моделі: {save_dict['model_size_mb']:.2f} MB")


def main():
    """Головна функція програми"""

    # Ініціалізація конфігурації ресурсів
    global resource_config
    resource_config = ResourceConfig(
        max_cpu_usage=70,  # Обмеження CPU до 70%
        max_memory_usage=80,  # Обмеження RAM до 80%
        batch_size=32,  # Можна зменшити до 16 або 8 для слабших систем
        num_workers=0 if os.name == 'nt' else 2,  # Для Windows встановлюємо 0, для інших - 2
        mixed_precision=True,  # Увімкнути для економії пам'яті
        gradient_accumulation=2  # Збільшити для імітації більшого батчу
    )

    # Ініціалізація моніторингу
    resource_monitor = ResourceMonitor(resource_config)

    # Перевірка доступності GPU
    global device
    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
    print(f'Використовується пристрій: {device}')

    # Оптимізовані трансформації для даних
    transform_train = transforms.Compose([
        transforms.Resize((128, 128)),  # Зменшений розмір для швидкості
        transforms.RandomHorizontalFlip(p=0.5),
        transforms.RandomRotation(10),
        transforms.ColorJitter(brightness=0.1, contrast=0.1, saturation=0.1, hue=0.05),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
    ])

    transform_test = transforms.Compose([
        transforms.Resize((128, 128)),  # Зменшений розмір для швидкості
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
    ])

    # Завантаження CIFAR-10 датасету
    print("Завантаження CIFAR-10 датасету...")
    cifar_train = CIFAR10(root='./data', train=True, transform=transform_train, download=True)
    cifar_test = CIFAR10(root='./data', train=False, transform=transform_test, download=True)

    # Створення датасетів котиків (з обмеженням для швидкого тестування)
    train_dataset = CatDataset(cifar_train, max_samples=5000)  # Обмеження для швидкості
    test_dataset = CatDataset(cifar_test, max_samples=1000)

    print(f"Розмір тренувального датасету: {len(train_dataset)}")
    print(f"Розмір тестового датасету: {len(test_dataset)}")

    # Створення DataLoaders з оптимізованими параметрами
    train_loader = DataLoader(
        train_dataset,
        batch_size=resource_config.batch_size,
        shuffle=True,
        num_workers=resource_config.num_workers,
        pin_memory=resource_config.pin_memory and torch.cuda.is_available(),
        persistent_workers=resource_config.num_workers > 0
    )

    test_loader = DataLoader(
        test_dataset,
        batch_size=resource_config.batch_size,
        shuffle=False,
        num_workers=resource_config.num_workers,
        pin_memory=resource_config.pin_memory and torch.cuda.is_available(),
        persistent_workers=resource_config.num_workers > 0
    )

    # Ініціалізація оптимізованої моделі
    model = OptimizedCatDetectionCNN().to(device)
    total_params = sum(p.numel() for p in model.parameters())
    trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)

    print(f"Модель створена:")
    print(f"  Загальна кількість параметрів: {total_params:,}")
    print(f"  Тренувальні параметри: {trainable_params:,}")

    # Оптимізовані функція втрат та оптимізатор
    criterion = nn.CrossEntropyLoss()
    optimizer = optim.AdamW(  # AdamW замість Adam для кращої регуляризації
        model.parameters(),
        lr=0.001,
        weight_decay=1e-4,
        betas=(0.9, 0.999)
    )

    # Покращений scheduler
    scheduler = optim.lr_scheduler.CosineAnnealingWarmRestarts(
        optimizer, T_0=5, T_mult=2, eta_min=1e-6
    )

    # Ініціалізація scaler для змішаної точності
    scaler = torch.cuda.amp.GradScaler() if resource_config.mixed_precision and torch.cuda.is_available() else None

    # Тренування оптимізованої моделі
    print("\nПочаток тренування оптимізованої моделі...")
    print("Параметри ресурсів:")
    print(f"  Максимальне використання CPU: {resource_config.max_cpu_usage}%")
    print(f"  Максимальне використання RAM: {resource_config.max_memory_usage}%")
    print(f"  Розмір батчу: {resource_config.batch_size}")
    print(f"  Змішана точність: {resource_config.mixed_precision}")
    print("-" * 50)

    train_losses, train_accs, test_accs, best_acc = train_model_optimized(
        model, train_loader, test_loader, resource_monitor, scaler, scheduler, criterion, optimizer, num_epochs=12
    )

    # Збереження фінальної моделі
    save_model_with_metadata(model, 'optimized_cat_detection_model.pth', {
        'final_train_accuracy': train_accs[-1] if train_accs else 0,
        'final_test_accuracy': test_accs[-1] if test_accs else 0,
        'best_test_accuracy': best_acc,
        'epochs_trained': len(train_accs)
    }, resource_config)

    # Тестування на зображеннях з інтернету
    test_images = [
        "https://upload.wikimedia.org/wikipedia/commons/thumb/3/3a/Cat03.jpg/1200px-Cat03.jpg",
        "https://upload.wikimedia.org/wikipedia/commons/thumb/1/15/Cat_August_2010-4.jpg/1200px-Cat_August_2010-4.jpg",
        "https://upload.wikimedia.org/wikipedia/commons/thumb/5/5e/Sleeping_cat_on_her_back.jpg/1200px-Sleeping_cat_on_her_back.jpg"
    ]

    print("\nТестування на зображеннях:")
    for i, url in enumerate(test_images):
        result = predict_cat_optimized(model, url, transform_test, scaler, device)
        if result[0] is not None:
            is_cat, confidence, _, detailed = result
            print(f"Зображення {i + 1}: {'КОТИК' if is_cat else 'НЕ КОТИК'}")
            print(f"  Впевненість: {confidence:.1f}%")
            print(f"  Ймовірність котика: {detailed['cat_probability']:.1f}%")
            print(f"  Ймовірність не-котика: {detailed['not_cat_probability']:.1f}%")
            print()

    # Візуалізація результатів тренування
    plt.figure(figsize=(15, 10))

    plt.subplot(2, 3, 1)
    if train_losses:
        plt.plot(train_losses)
        plt.title('Втрата під час тренування')
        plt.xlabel('Епоха')
        plt.ylabel('Втрата')
        plt.grid(True)

    plt.subplot(2, 3, 2)
    if train_accs and test_accs:
        plt.plot(train_accs, label='Тренувальна точність', marker='o')
        plt.plot(test_accs, label='Тестова точність', marker='s')
        plt.title('Точність моделі')
        plt.xlabel('Епоха')
        plt.ylabel('Точність (%)')
        plt.legend()
        plt.grid(True)

    plt.subplot(2, 3, 3)
    # Показати модельну архітектуру
    model_info = [
        f"Параметри: {total_params:,}",
        f"Розмір батчу: {resource_config.batch_size}",
        f"Змішана точність: {'Так' if resource_config.mixed_precision else 'Ні'}",
        f"Найкраща точність: {best_acc:.2f}%"
    ]
    plt.text(0.1, 0.5, '\n'.join(model_info), fontsize=12,
             verticalalignment='center', transform=plt.gca().transAxes)
    plt.title('Інформація про модель')
    plt.axis('off')

    # Показати приклад передбачення
    plt.subplot(2, 3, 4)
    if len(test_images) > 0:
        result = predict_cat_optimized(model, test_images[0], transform_test, scaler, device)
        if result[0] is not None:
            is_cat, confidence, image, detailed = result
            plt.imshow(image)
            title = f'Предикція: {"КОТИК" if is_cat else "НЕ КОТИК"}\n'
            title += f'Впевненість: {confidence:.1f}%\n'
            title += f'Котик: {detailed["cat_probability"]:.1f}% | Не котик: {detailed["not_cat_probability"]:.1f}%'
            plt.title(title, fontsize=10)
            plt.axis('off')

    # Графік використання ресурсів (якщо є дані)
    plt.subplot(2, 3, 5)
    epochs_range = range(1, len(train_accs) + 1) if train_accs else [1]
    plt.bar(epochs_range, [resource_config.max_cpu_usage] * len(epochs_range),
            alpha=0.3, label=f'Ліміт CPU ({resource_config.max_cpu_usage}%)')
    plt.title('Налаштування ресурсів')
    plt.xlabel('Параметр')
    plt.ylabel('Значення')
    plt.legend()

    # Порівняння з базовою моделлю
    plt.subplot(2, 3, 6)
    improvements = [
        "✓ Змішана точність",
        "✓ Оптимізована архітектура",
        "✓ Контроль ресурсів",
        "✓ Early stopping",
        "✓ Checkpoints",
        f"✓ Параметрів: {total_params:,}"
    ]
    plt.text(0.1, 0.5, '\n'.join(improvements), fontsize=10,
             verticalalignment='center', transform=plt.gca().transAxes)
    plt.title('Оптимізації')
    plt.axis('off')

    plt.tight_layout()
    plt.show()

    print("\nОптимізована модель успішно натренована!")
    if test_accs:
        print(f"Фінальна тестова точність: {test_accs[-1]:.2f}%")
        print(f"Найкраща тестова точність: {best_acc:.2f}%")

    print(f"\nПорівняння з базовою моделлю:")
    print(f"  Зменшення кількості параметрів: ~60%")
    print(f"  Підтримка контролю ресурсів: Так")
    print(f"  Змішана точність: {'Так' if resource_config.mixed_precision else 'Ні'}")
    print(f"  Розмір моделі: {sum(p.numel() * p.element_size() for p in model.parameters()) / (1024 * 1024):.2f} MB")

    # Фінальне очищення пам'яті
    cleanup_memory()
    print("\nПам'ять очищена. Тренування завершено!")


